<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The hardened runtime is required for notarisation, and it blocks
         microphone access unless the app asks for it here. The Accessibility
         event tap needs no entitlement — only the user's grant. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
